{
  "name": "docdeck",
  "version": "0.1.0",
  "description": "Build a themed client deck (16:9) and document (A4) as HTML and PDF from Markdown chapters and live project data.",
  "private": true,
  "type": "module",
  "bin": {
    "docdeck": "./bin/docdeck.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["bin", "src", "templates", "styles", "skill"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "nunjucks": "^3.2.4",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.62.1",
    "tsx": "^4.19.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^2.0.10",
    "@types/node": "^22.10.5",
    "@types/nunjucks": "^3.2.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
