{% macro cover(project, logo, labels) %}
<div class="dd-cover-inner">
  <div class="dd-cover-brand">{% if logo %}<img class="dd-logo" src="{{ logo }}" alt="{{ project.name }}">{% else %}<span class="dd-wordmark">{{ project.name }}</span>{% endif %}</div>
  <div class="dd-cover-title">
    <div class="dd-kicker">{{ project.name }}</div>
    <h1>{{ project.title }}</h1>
    {% if project.tagline %}<p class="dd-tagline">{{ project.tagline }}</p>{% endif %}
  </div>
  <dl class="dd-cover-meta">
    {% if project.audience %}<div><dt>{{ labels.preparedFor }}</dt><dd>{{ project.audience }}</dd></div>{% endif %}
    <div><dt>{{ labels.edition }}</dt><dd>{{ project.edition }}</dd></div>
  </dl>
</div>
{% endmacro %}
